# Linux check image for dynide (used by ../linux_check.sh).
# lua5.4: tty_harness.py plugins runs herdr's dev-layout-bootstrap (`lua setup.lua`);
# git comes from the dynide-m2-check base (its apt layer installs it; checked with
# `podman image history` and `git --version` in the image).
FROM localhost/dynide-m2-check
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    htop inotify-tools lua5.4 procps rsync \
 && rm -rf /var/lib/apt/lists/* \
 && { command -v lua || ln -s /usr/bin/lua5.4 /usr/local/bin/lua; } \
 && lua -v
