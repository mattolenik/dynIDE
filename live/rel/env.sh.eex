#!/bin/sh
# M18 (R3): no distribution, so no epmd and no node name; a warm standby and the
# primary never clash over one.
export RELEASE_DISTRIBUTION=none
# Each boot writes its runtime config under RELEASE_TMP (removed once read); the
# default, <release root>/tmp, is not writable in a root-owned install.
export RELEASE_TMP="${RELEASE_TMP:-${TMPDIR:-/tmp}}"
