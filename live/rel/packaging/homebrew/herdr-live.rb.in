class HerdrLive < Formula
  desc "Terminal multiplexer for AI agents that you can edit while it runs"
  # fork origin; the human confirms the homepage at publish
  homepage "https://github.com/mattolenik/herdr"
  url "@URL@"
  version "@VERSION@"
  sha256 "@SHA256@"
  license "Apache-2.0"

  depends_on arch: :arm64
  depends_on :macos

  def install
    # the release tree is self-contained (bundled erts, kernel, libcrypto via @loader_path):
    # it goes flat into libexec; the launcher resolves the bin symlink back to it
    libexec.install Dir["*"]
    (libexec/"releases/managed-by").write "homebrew\n"
    bin.install_symlink libexec/"bin/herdr-live"
  end

  def caveats
    <<~EOS
      Updates come from Homebrew (brew upgrade herdr-live); `herdr-live update`
      only works for installs made with install.sh.
    EOS
  end

  test do
    assert_match "herdr-live #{version}", shell_output("#{bin}/herdr-live --version")
  end
end
