#!/bin/sh
# herdr-live launcher (dev build). Usage: herdr-live [kernel-restart | status | <verb> ...]
# With no argument it builds native/herdr_broker and execs `herdr_broker run`,
# which supervises the VMs (warm standby, fd holding, handoff on kill -9 or
# kernel-restart) and restores the host tty at exit (it replaces
# scripts/tty_guard.sh here). The VMs never touch stdio: stdin is /dev/null
# and stdout/stderr (broker log lines, first-compile output) go to the log.
# HERDR_LIVE_HEADLESS=1 (inherited by the VMs) starts no terminal client.
# HERDR_LIVE_RUNTIME_DIR picks the broker socket dir (read by the broker).
# kernel-restart and status talk to the running broker on this terminal.
# Session persistence (M8): the VM saves the layout, focus, ui prefs, pane cwds and
# scrollback to <state dir>/session.<name>.etf and restores them at the next start.
# HERDR_LIVE_STATE_DIR is the state dir (default ${XDG_STATE_HOME:-$HOME/.local/state}/herdr-live),
# HERDR_LIVE_SESSION the name (default `default`; [A-Za-z0-9_.-], at most 64),
# HERDR_LIVE_PERSIST=0 turns persistence off. Scripted launches set their own state dir.
# With HERDR_LIVE_RUNTIME_DIR set and HERDR_LIVE_STATE_DIR unset, the state dir defaults to
# $HERDR_LIVE_RUNTIME_DIR/state, so two instances with their own runtime dirs never share
# one session file.
#
# Every other verb (ping, pane ..., rollback, test-on-save, ...; `herdr-live help`
# lists them, docs/herdr-live/api.md describes them) runs the CLI (apps/herdr_cli)
# against the API socket ($HERDR_LIVE_API, else the api.sock beside the default log):
# `erl -noinput` with Elixir's ebin and the CLI's ebin, no mix and no Elixir boot,
# ~150 ms p50 vs ~270 ms for `elixir -e` or an escript (M12 task 7). It never reads stdin.
# Elixir's ebin dir is asked from `elixir` once and cached in _build/dev (version
# managers' shims defeat symlink resolution); the cache is redone when the dir is gone.
# Exit codes: 0 ok, 1 API error (JSON on stderr) or not running, 2 usage.
# `status` prints the broker's status, then the server's (key=value) when it answers.
#
# herdr-live rollback [n]: roll back the newest n live reload batches (default 1)
# through the API socket of the running instance (HerdrServer.Api.Listener, served
# by the current primary VM; a promoted VM takes the socket over).
# A rolled-back source is reloaded again only when its content changes: re-saving
# or touching the same bytes does nothing (edit it, or revert it, to reload).
# herdr-live test-on-save [on|off]: switch the test-on-save gate (a save runs the changed
# module's tests in a separate mix test first; failing tests block the reload). No
# argument prints the current mode (ok gate | ok off). Off by default; it adds seconds
# per save. HERDR_LIVE_TEST_ON_SAVE=1 starts it on. The runtime setting does not survive
# a VM handoff (the new VM falls back to HERDR_LIVE_TEST_ON_SAVE / config).
# resolve symlinks (portable: no readlink -f on macOS)
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd) || exit 1
cli() { # runs in the caller's cwd, so a relative HERDR_LIVE_API keeps its meaning
  ebin=$root/_build/dev/lib/herdr_cli/ebin
  [ -d "$ebin" ] || (cd "$root" && MIX_ENV=dev mix compile) >&2 || exit 1
  cache=$root/_build/dev/herdr_cli.elixir_ebin
  exs=$(cat "$cache" 2>/dev/null)
  if [ ! -f "$exs/elixir.app" ]; then
    exs=$(elixir -e 'IO.puts(Path.join(Path.expand(:code.lib_dir(:elixir)), "ebin"))') || exit 1
    printf '%s\n' "$exs" >"$cache.$$" && mv "$cache.$$" "$cache"
  fi
  # no crash dump in the caller's cwd if the VM cannot boot
  ERL_CRASH_DUMP_SECONDS=0 exec erl -noinput -boot no_dot_erlang -pa "$exs" -pa "$ebin" -run Elixir.HerdrCli main_erl -extra "$@"
}
case ${1:-} in
  kernel-restart | status | '') ;;
  *) cli "$@" ;;
esac
log=${HERDR_LIVE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-live/herdr-live.log}
case $log in /*) ;; *) log=$PWD/$log ;; esac
case ${HERDR_LIVE_RUNTIME_DIR:-} in /* | '') ;; *) HERDR_LIVE_RUNTIME_DIR=$PWD/$HERDR_LIVE_RUNTIME_DIR ;; esac
case ${HERDR_LIVE_STATE_DIR:-} in /* | '') ;; *) export HERDR_LIVE_STATE_DIR="$PWD/$HERDR_LIVE_STATE_DIR" ;; esac
# an ad-hoc instance (its own runtime dir) gets its own session file too
if [ -n "${HERDR_LIVE_RUNTIME_DIR:-}" ] && [ -z "${HERDR_LIVE_STATE_DIR:-}" ]; then
  export HERDR_LIVE_STATE_DIR="$HERDR_LIVE_RUNTIME_DIR/state"
fi
# 0700 when created here: the API socket (HerdrServer.Api.Listener) lives beside the log
(umask 077 && mkdir -p "$(dirname "$log")") || exit 1
sock=${HERDR_LIVE_API:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-live/api.sock}
case $sock in /*) ;; *) sock=$PWD/$sock ;; esac
cd "$root" || exit 1
broker=$PWD/native/herdr_broker/target/release/herdr_broker
build() { cargo build --release --locked --quiet --manifest-path native/herdr_broker/Cargo.toml; }
case ${1:-} in
  kernel-restart)
    [ -x "$broker" ] || build >&2 || exit 1
    exec "$broker" "$1"
    ;;
  status)
    [ -x "$broker" ] || build >&2 || exit 1
    "$broker" status
    rc=$?
    [ -S "$sock" ] && (HERDR_LIVE_API=$sock cli server status --kv 2>/dev/null)
    exit $rc
    ;;
esac
export MIX_ENV="${MIX_ENV:-dev}"
exec </dev/null >>"$log" 2>&1
build || exit 1
# +Bi: the VMs share the broker's process group, so a terminal ^C must not
# open the BEAM break menu (the broker turns SIGINT into a clean stop).
exec "$broker" run -- elixir --erl "-noshell -noinput +Bi" -S mix run --no-halt
