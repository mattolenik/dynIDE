#!/bin/sh
# Headless herdr-live launcher (dev build). The VM never touches the terminal:
# stdin is /dev/null and stdout/stderr go to the log, including first-compile output.
log=${HERDR_LIVE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-live/herdr-live.log}
mkdir -p "$(dirname "$log")" || exit 1
cd "$(dirname "$0")/.." || exit 1
export MIX_ENV="${MIX_ENV:-dev}"
exec </dev/null >>"$log" 2>&1
exec elixir --erl "-noshell -noinput" -S mix run --no-halt
