#!/bin/sh
# herdr-live launcher. Usage: herdr-live [kernel-restart | status | --version | <verb> ...]
# One script for both layouts (M18 R2): in a source tree (live/bin/herdr-live) it runs
# mix and cargo as described below; in a release root (scripts/release/build.sh: it has
# releases/start_erl.data) it runs the bundled broker, `bin/herdr_live start` as the VM
# with cwd $HOME, and the bundled erts for the CLI and the attach client (no elixir,
# mix or cargo on PATH). Installed as <prefix>/bin/herdr-live -> ../lib/herdr-live/current/
# bin/herdr-live (R4), symlinks are resolved only down to that path, never through
# `current`, so the broker's VM argv (and a kernel-restart) follows a flipped `current`,
# and HERDR_LIVE_BIN is the path it was invoked through. `--version` prints
# `herdr-live <V>` (a source tree: mix.exs's version with -dev).
# With no argument it builds native/herdr_broker and execs `herdr_broker run`,
# which supervises the VMs (warm standby, fd holding, handoff on kill -9 or
# kernel-restart) and restores the host tty at exit; attached, scripts/tty_guard.sh
# runs it and restores the tty when the broker itself is killed (kill -9).
# The VMs never touch stdio: stdin is /dev/null and stdout/stderr (broker log
# lines, first-compile output) go to the log.
# HERDR_LIVE_HEADLESS=1 (inherited by the VMs) starts no terminal client.
# HERDR_LIVE_RUNTIME_DIR picks the broker socket dir (read by the broker).
# kernel-restart and status talk to the running broker on this terminal.
# Session persistence (M8): the VM saves the layout, focus, ui prefs, pane cwds and
# scrollback to <state dir>/session.<name>.etf and restores them at the next start.
# HERDR_LIVE_STATE_DIR is the state dir (default ${XDG_STATE_HOME:-$HOME/.local/state}/herdr-live),
# HERDR_LIVE_SESSION the name (default `default`; [A-Za-z0-9_.-], at most 64),
# HERDR_LIVE_PERSIST=0 turns persistence off. Scripted launches set their own state dir.
# With HERDR_LIVE_RUNTIME_DIR set and HERDR_LIVE_STATE_DIR unset, the state dir defaults to
# $HERDR_LIVE_RUNTIME_DIR/state, so two instances with their own runtime dirs never share
# one session file.
#
# herdr-live update [--manifest URL] [--check] [--yes] [--no-restart] (M18, release only
# beyond --check): HerdrCli.Update; docs/herdr-live/site/update-manifest.md.
# Every other verb (ping, pane ..., rollback, test-on-save, ...; `herdr-live help`
# lists them, docs/herdr-live/api.md describes them) runs the CLI (apps/herdr_cli)
# against the API socket ($HERDR_LIVE_API, else the api.sock beside the default log):
# `erl -noinput` with Elixir's ebin and the CLI's ebin, no mix and no Elixir boot,
# ~150 ms p50 vs ~270 ms for `elixir -e` or an escript (M12 task 7). It never reads stdin.
# Elixir's ebin dir is asked from `elixir` once and cached in _build/dev (version
# managers' shims defeat symlink resolution); the cache is redone when the dir is gone.
# Exit codes: 0 ok (help and --help print usage to stdout), 1 API error (JSON on
# stderr), not running, or an event stream the server closed, 2 usage.
#
# Remote attach (M16): `attach [<host>] [<session>]`, `terminal attach|observe <pane_id>
# [--host <host>]` run a terminal client VM (mix run, HerdrTerm.Remote.main/1) with HERDR_LIVE_HEADLESS=1
# and stdio sent to $HERDR_LIVE_CLIENT_LOG (default client.log beside the default server log).
# It talks to the client socket (HERDR_LIVE_CLIENT_SOCK, else client.sock beside the API socket),
# or over ssh to <host>, which runs `herdr-live attach-relay` there (HERDR_LIVE_SSH,
# HERDR_LIVE_REMOTE_BIN; BatchMode, so ssh needs key or agent auth). The launcher checks the
# argv shape and prints usage itself (the client VM's output goes to its log); ids are checked there.
# A client that exits nonzero (a refusal, an unreachable host) gets one line on stderr with
# its reason and the log path. The relay runs in ssh's non-interactive environment: it finds
# the server's sockets from that environment's HERDR_LIVE_API / HERDR_LIVE_CLIENT_SOCK /
# XDG_STATE_HOME defaults and herdr-live on that PATH, so a server with custom paths or an
# install off the non-interactive PATH needs HERDR_LIVE_REMOTE_BIN (e.g. a wrapper that
# exports them).
# `status` prints the broker's status, then the server's (key=value) when it answers.
#
# herdr-live rollback [n]: roll back the newest n live reload batches (default 1)
# through the API socket of the running instance (HerdrServer.Api.Listener, served
# by the current primary VM; a promoted VM takes the socket over).
# A rolled-back source is reloaded again only when its content changes: re-saving
# or touching the same bytes does nothing (edit it, or revert it, to reload).
# herdr-live test-on-save [on|off]: switch the test-on-save gate (a save runs the changed
# module's tests in a separate mix test first; failing tests block the reload). No
# argument prints the current mode (ok gate | ok off). Off by default; it adds seconds
# per save. HERDR_LIVE_TEST_ON_SAVE=1 starts it on. The runtime setting does not survive
# a VM handoff (the new VM falls back to HERDR_LIVE_TEST_ON_SAVE / config).
# resolve symlinks (portable: no readlink -f on macOS)
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd) || exit 1
rel='' bin=$root/bin/herdr-live
if [ -f "$root/releases/start_erl.data" ]; then
  rel=$(cut -d' ' -f2 "$root/releases/start_erl.data") || exit 1
  # HERDR_LIVE_BIN: the path invoked (the install symlink), so pane shells survive an update
  case $0 in /*) bin=$0 ;; *) bin=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") || exit 1 ;; esac
  # the release scripts honour these from the env: a stale one (another release's, or a
  # pane of an older version) would boot the wrong files
  unset RELEASE_NAME RELEASE_VSN RELEASE_PROG RELEASE_COOKIE RELEASE_MODE RELEASE_NODE \
    RELEASE_TMP RELEASE_VM_ARGS RELEASE_REMOTE_VM_ARGS RELEASE_DISTRIBUTION \
    RELEASE_BOOT_SCRIPT RELEASE_BOOT_SCRIPT_CLEAN RELEASE_SYS_CONFIG ERL_ROOTDIR
  # erlexec puts the bundled erts bin and the release's bin first on a VM's PATH; the VMs
  # give their children (panes, plugins, hooks, ssh) this one back (config/runtime.exs)
  export HERDR_LIVE_PANE_PATH="$PATH"
fi
cli() { # runs in the caller's cwd, so a relative HERDR_LIVE_API keeps its meaning
  if [ -n "$rel" ]; then # the release's erts and ebins; bin/no_dot_erlang.boot is OTP's
    # through `current` resolved: a CLI that loads a module after `update` flipped `current`
    # (HerdrCli.Update) still loads it from its own release
    real=$(cd -P "$root" && pwd) || exit 1
    for erl in "$real"/erts-*/bin/erl; do :; done
    for exs in "$real"/lib/elixir-*/ebin; do :; done
    for ebin in "$real"/lib/herdr_cli-*/ebin; do :; done
    for scene in "$real"/lib/herdr_scene-*/ebin; do :; done
    ERL_CRASH_DUMP_SECONDS=0 exec "$erl" -noinput -boot no_dot_erlang -pa "$exs" -pa "$ebin" -pa "$scene" -run Elixir.HerdrCli main_erl -extra "$@"
  fi
  ebin=$root/_build/dev/lib/herdr_cli/ebin
  [ -d "$ebin" ] || (cd "$root" && MIX_ENV=dev mix compile) >&2 || exit 1
  cache=$root/_build/dev/herdr_cli.elixir_ebin
  exs=$(cat "$cache" 2>/dev/null)
  if [ ! -f "$exs/elixir.app" ]; then
    exs=$(elixir -e 'IO.puts(Path.join(Path.expand(:code.lib_dir(:elixir)), "ebin"))') || exit 1
    printf '%s\n' "$exs" >"$cache.$$" && mv "$cache.$$" "$cache"
  fi
  # no crash dump in the caller's cwd if the VM cannot boot
  ERL_CRASH_DUMP_SECONDS=0 exec erl -noinput -boot no_dot_erlang -pa "$exs" -pa "$ebin" -pa "$root/_build/dev/lib/herdr_scene/ebin" -run Elixir.HerdrCli main_erl -extra "$@"
}
client_usage() {
  cat <<'USAGE'
usage:
  herdr-live attach [<host>] [<session>]
  herdr-live terminal attach <pane_id> [--host <host>]
  herdr-live terminal observe <pane_id> [--host <host>]
USAGE
}
client() { # attach | terminal: the remote client VM, stdio to its log (R18)
  for a in "$@"; do
    case $a in --help | -h) client_usage && exit 0 ;; esac
  done
  case $1:$# in
    attach:[1-3]) ;;
    terminal:3 | terminal:5)
      case $2 in attach | observe) ;; *) client_usage >&2 && exit 2 ;; esac
      [ $# -eq 3 ] || [ "$4" = --host ] || { client_usage >&2 && exit 2; }
      ;;
    *) client_usage >&2 && exit 2 ;;
  esac
  clog=${HERDR_LIVE_CLIENT_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-live/client.log}
  case $clog in /*) ;; *) clog=$PWD/$clog ;; esac
  case ${HERDR_LIVE_API:-} in /* | '') ;; *) HERDR_LIVE_API=$PWD/$HERDR_LIVE_API ;; esac
  case ${HERDR_LIVE_CLIENT_SOCK:-} in /* | '') ;; *) HERDR_LIVE_CLIENT_SOCK=$PWD/$HERDR_LIVE_CLIENT_SOCK ;; esac
  [ -z "${HERDR_LIVE_API:-}" ] || export HERDR_LIVE_API
  [ -z "${HERDR_LIVE_CLIENT_SOCK:-}" ] || export HERDR_LIVE_CLIENT_SOCK
  (umask 077 && mkdir -p "$(dirname "$clog")") || exit 1
  if [ -n "$rel" ]; then # eval boots no app (Remote.main starts herdr_term); argv as given
    set -- "$root/bin/herdr_live" eval 'HerdrTerm.Remote.main(System.argv())' "$@"
  else
    export MIX_ENV=dev
    command -v elixir >/dev/null 2>&1 || {
      echo "herdr-live: elixir not found on PATH (the attach client runs under mix)" >&2
      exit 1
    }
    cd "$root" || exit 1
    set -- elixir --erl "-noshell -noinput +Bi" -S mix run --no-halt --no-start -e 'HerdrTerm.Remote.main(System.argv())' -- "$@"
  fi
  # not exec'd: a failure's reason (HerdrTerm.Remote.fail/1) goes to this stderr
  reason=$(mktemp "${TMPDIR:-/tmp}/herdr-live-client.XXXXXX") || exit 1
  trap 'rm -f "$reason"' EXIT
  # background + wait so TERM/HUP/INT reach the VM (a foreground child would not see them while
  # sh waits). A non-interactive sh has no job control: the job stays in this process group, so
  # the VM keeps the foreground tty (it opens /dev/tty itself) and gets no SIGTTIN/SIGTTOU.
  HERDR_LIVE_HEADLESS=1 HERDR_LIVE_CLIENT_REASON=$reason "$@" </dev/null >>"$clog" 2>&1 &
  pid=$!
  trap 'kill -TERM $pid 2>/dev/null' TERM HUP INT
  wait $pid
  rc=$?
  # a trapped signal ends the first wait early: wait for the VM to really go
  while kill -0 $pid 2>/dev/null; do wait $pid; rc=$?; done
  if [ $rc -ne 0 ]; then
    why=$(cat "$reason" 2>/dev/null)
    echo "herdr-live: client exited ($rc)${why:+: $why}; see $clog" >&2
  fi
  exit $rc
}
# dispatch on $#: only no argument at all starts a server (an empty verb is usage)
if [ $# -gt 0 ]; then
  case $1 in
    kernel-restart | status) ;;
    --version)
      if [ -n "$rel" ]; then
        echo "herdr-live $rel"
      else
        echo "herdr-live $(sed -n 's/^  @version "\(.*\)"$/\1/p' "$root/mix.exs")-dev"
      fi
      exit 0
      ;;
    attach | terminal) client "$@" ;;
    *) cli "$@" ;;
  esac
fi
log=${HERDR_LIVE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-live/herdr-live.log}
case $log in /*) ;; *) log=$PWD/$log ;; esac
case ${HERDR_LIVE_RUNTIME_DIR:-} in /* | '') ;; *) HERDR_LIVE_RUNTIME_DIR=$PWD/$HERDR_LIVE_RUNTIME_DIR ;; esac
case ${HERDR_LIVE_STATE_DIR:-} in /* | '') ;; *) export HERDR_LIVE_STATE_DIR="$PWD/$HERDR_LIVE_STATE_DIR" ;; esac
# an ad-hoc instance (its own runtime dir) gets its own session file too
if [ -n "${HERDR_LIVE_RUNTIME_DIR:-}" ] && [ -z "${HERDR_LIVE_STATE_DIR:-}" ]; then
  export HERDR_LIVE_STATE_DIR="$HERDR_LIVE_RUNTIME_DIR/state"
fi
# 0700 when created here: the API socket (HerdrServer.Api.Listener) lives beside the log
(umask 077 && mkdir -p "$(dirname "$log")") || exit 1
sock=${HERDR_LIVE_API:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-live/api.sock}
case $sock in /*) ;; *) sock=$PWD/$sock ;; esac
if [ -n "$rel" ]; then
  # pane shells start in the VM's cwd: $HOME, never the release dir
  cd "${HOME:-/}" || exit 1
  broker=$root/bin/herdr_broker
  build() { echo "herdr-live: $broker is missing" >&2 && return 1; }
else
  cd "$root" || exit 1
  broker=$PWD/native/herdr_broker/target/release/herdr_broker
  build() { cargo build --release --locked --quiet --manifest-path native/herdr_broker/Cargo.toml; }
fi
case ${1:-} in
  kernel-restart)
    [ -x "$broker" ] || build >&2 || exit 1
    # a release restarts into `current` (the broker keeps that argv once it succeeds;
    # `update` passes releases/<V> itself and flips `current` after)
    [ -z "$rel" ] || exec "$broker" kernel-restart -- "$root/bin/herdr_live" start
    exec "$broker" "$1"
    ;;
  status)
    [ -x "$broker" ] || build >&2 || exit 1
    "$broker" status
    rc=$?
    [ -S "$sock" ] && (HERDR_LIVE_API=$sock cli server status --kv 2>/dev/null)
    exit $rc
    ;;
esac
# pane shells inherit both: an agent in a pane runs "$HERDR_LIVE_BIN" pane ... against this instance
export HERDR_LIVE_BIN="$bin" HERDR_LIVE_API="$sock"
# herdr's names for the same two, so herdr plugins and scripts find this instance
export HERDR_SOCKET_PATH="$sock" HERDR_BIN_PATH="$bin"
exec </dev/null >>"$log" 2>&1
[ -n "$rel" ] || build || exit 1
# the VM argv. +Bi (the release's vm.args has it too): the VMs share the broker's
# process group, so a terminal ^C must not open the BEAM break menu (the broker
# turns SIGINT into a clean stop).
if [ -n "$rel" ]; then
  set -- "$root/bin/herdr_live" start
else
  export MIX_ENV="${MIX_ENV:-dev}"
  set -- elixir --erl "-noshell -noinput +Bi" -S mix run --no-halt
fi
[ "${HERDR_LIVE_HEADLESS:-}" = 1 ] &&
  exec "$broker" run -- "$@"
# attached: tty_guard.sh is the backstop for a broker that cannot run its own
# restore (kill -9); it logs that as broker_killed (an operator kill, not a loss)
export HERDR_GUARD_EVENT_LOG="$log"
exec "$root/scripts/tty_guard.sh" "$broker" run -- "$@"
